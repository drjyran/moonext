generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SITE_MANAGER
  CONTRACTOR
}

enum LabourStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  OVERTIME
}

enum ShiftType {
  FULL_TIME
  HALF_TIME
  OVER_TIME
  ABSENT
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id           String      @id @default(cuid())
  fullName     String
  email        String      @unique
  phone        String?     @unique
  passwordHash String
  role         Role
  siteId       String?
  contractorId String?
  site         Site?       @relation(fields: [siteId], references: [id])
  contractor   Contractor? @relation(fields: [contractorId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Site {
  id            String       @id @default(cuid())
  name          String
  state         String
  city          String
  projectStart  DateTime
  projectEnd    DateTime
  isActive      Boolean      @default(true)
  siteManagerId String?
  siteManagers  User[]
  labours       Labour[]
  attendances   Attendance[]
  wageRecords   WageRecord[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Contractor {
  id          String       @id @default(cuid())
  name        String
  phone       String       @unique
  email       String?      @unique
  address     String?
  users       User[]
  labours     Labour[]
  wageRecords WageRecord[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Labour {
  id             String       @id @default(cuid())
  fullName       String
  phone          String       @unique
  aadhaarNumber  String       @unique
  skillType      String
  dailyWage      Decimal      @db.Decimal(10, 2)
  halfDayWage    Decimal?     @db.Decimal(10, 2)
  overtimeWage   Decimal?     @db.Decimal(10, 2)
  status         LabourStatus @default(ACTIVE)
  assignedSiteId String
  contractorId   String
  aadhaarDocUrl  String?
  photoUrl       String?
  assignedSite   Site         @relation(fields: [assignedSiteId], references: [id])
  contractor     Contractor   @relation(fields: [contractorId], references: [id])
  attendances    Attendance[]
  wageRecords    WageRecord[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Attendance {
  id        String           @id @default(cuid())
  labourId  String
  siteId    String
  date      DateTime
  status    AttendanceStatus
  shiftType ShiftType        @default(FULL_TIME)
  overtimeHours Decimal      @default(0) @db.Decimal(5, 2)
  workDescription String?
  labour    Labour           @relation(fields: [labourId], references: [id])
  site      Site             @relation(fields: [siteId], references: [id])
  createdAt DateTime         @default(now())

  @@unique([labourId, date])
  @@index([siteId, date])
}

model WageRecord {
  id            String        @id @default(cuid())
  labourId      String
  siteId        String
  contractorId  String
  month         Int
  year          Int
  presentDays   Decimal       @db.Decimal(5, 2)
  fullTimeDays  Decimal       @default(0) @db.Decimal(5, 2)
  halfTimeDays  Decimal       @default(0) @db.Decimal(5, 2)
  overtimeHours Decimal       @default(0) @db.Decimal(6, 2)
  fullTimePay   Decimal       @default(0) @db.Decimal(10, 2)
  halfTimePay   Decimal       @default(0) @db.Decimal(10, 2)
  overtimePay   Decimal       @default(0) @db.Decimal(10, 2)
  grossAmount   Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  pendingAmount Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  labour        Labour        @relation(fields: [labourId], references: [id])
  site          Site          @relation(fields: [siteId], references: [id])
  contractor    Contractor    @relation(fields: [contractorId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([labourId, month, year])
  @@index([siteId, month, year])
}
